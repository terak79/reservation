<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card p-4">
        <div class="text-center mb-4">
          <% if @user.icon.present? %>
            <%= image_tag @user.icon.url, style: "width: 100px; height: 100px; border-radius: 50%; object-fit: cover;" %>
          <% else %>
            <%= image_tag "icon.png", style: "width: 100px; height: 100px; border-radius: 50%; object-fit: cover;" %>
          <% end %>
          <h4 class="mt-3"><%= @user.name %></h4>
        </div>

        <table class="table">
          <tr>
            <th>メールアドレス</th>
            <td><%= @user.email %></td>
          </tr>
          <tr>
            <th>パスワード</th>
            <td>**********</td>
          </tr>
          <tr>
            <th>自己紹介</th>
            <td><%= @user.bio %></td>
          </tr>
        </table>

        <div class="d-flex gap-2 mt-3">
          <%= link_to "プロフィール編集", edit_users_profile_path, class: "btn btn-outline-secondary w-50" %>
          <%= link_to "アカウント情報編集", edit_user_registration_path, class: "btn btn-outline-secondary w-50" %>
        </div>
      </div>
    </div>
  </div>
</div>
