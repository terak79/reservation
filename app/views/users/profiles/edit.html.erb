<h1>プロフィール編集</h1>

<%= form_with model: @user, url: users_profile_path do |f| %>
  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<%= link_to "戻る", :back %>
