<div class="container mt-4">
  <%= link_to "← 戻る", :back, class: "text-decoration-none mb-3 d-inline-block" %>

  <div class="row justify-content-center mt-3">
    <div class="col-md-6">
      <div class="card p-4">
        <h2 class="mb-4">プロフィール編集</h2>

        <%= form_with model: @user, url: users_profile_path do |f| %>
          <div class="mb-3">
            <%= f.label :icon, "アイコン画像", class: "form-label" %>
            <%= f.file_field :icon, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :name, "名前", class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :bio, "自己紹介", class: "form-label" %>
            <%= f.text_area :bio, class: "form-control", rows: 4 %>
          </div>

          <%= f.submit "更新する", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
