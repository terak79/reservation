<h1>プロフィール編集</h1>

<%= form_with model: @user, url: users_profile_path do |f| %>
  <div>
    <%= f.label :icon, "アイコン画像" %>
    <%= f.file_field :icon %>
  </div>

  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<%= link_to "戻る", :back %>
