<div class="hero-section">
  <div class="hero-overlay">
    <h1 class="hero-title">Pickup Travelで<br>旅を身近に</h1>
  </div>  
</div>

<div class="container mt-4">
  <%= form_with url: rooms_path, method: :get do |f| %>
    <div class="d-flex gap-2 mb-3">
      <%= f.select :area, ["東京", "大阪", "京都", "札幌"], include_blank: "エリアを選択", class: "form-select w-auto" %>
      <%= f.text_field :keyword, placeholder: "フリーワード検索", class: "form-control" %>
      <%= f.submit "検索", class: "btn btn-primary" %>
    </div>
  <% end %>

  <p><%= @rooms_count %>件が見つかりました。</p>
  <% if user_signed_in? %>
    <%= link_to "施設を登録する", new_room_path, class: "btn btn-primary mb-3" %>
  <% end %>


  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @rooms.each do |room| %>
      <div class="col">
        <div class="card h-100">
          <% if room.image.present? %>
            <%= image_tag room.image.url, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% else %>
            <%= image_tag "defo.png", class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= link_to room.name, room_path(room) %></h5>
            <p class="card-text text-muted"><%= room.address %></p>
            <p class="card-text text-danger fw-bold">¥<%= number_with_delimiter(room.price) %>〜</p>
          </div>
          <div class="card-footer">
            <%= link_to "詳細はこちら", room_path(room), class: "btn btn-primary w-100" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
