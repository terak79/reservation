<div class="container mt-4">
  <h1>自分の施設一覧</h1>

  <%= link_to "施設を登録する", new_room_path, class: "btn btn-success mb-4" %>

  <% @rooms.each do |room| %>
    <div>
      <% if room.image.present? %>
        <%= image_tag room.image.url, style: "max-width: 300px;" %>
      <% end %>
      <p><%= link_to room.name, room_path(room) %></p>
      <p><%= room.description %></p>
      <p>¥<%= number_with_delimiter(room.price) %>/泊</p>
      <p><%= room.created_at.strftime("%Y/%m/%d") %></p>
    </div>
  <% end %>
</div>
