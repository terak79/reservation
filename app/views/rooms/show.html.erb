<div class="container mt-4">
  <%= link_to "← 戻る", :back, class: "text-decoration-none mb-3 d-inline-block" %>

  <div class="row mt-3">
    <div class="col-md-6">
      <% if @room.image.present? %>
        <%= image_tag @room.image.url, class: "img-fluid rounded", style: "width: 100%; height: 400px; object-fit: cover;" %>
      <% else %>
        <%= image_tag "defo.png", class: "img-fluid rounded", style: "width: 100%; height: 400px; object-fit: cover;" %>
      <% end %>
    </div>

    <div class="col-md-6">
      <h2><%= @room.name %></h2>
      <p class="text-muted"><%= @room.address %></p>
      <p class="text-danger fw-bold fs-4">¥<%= number_with_delimiter(@room.price) %>〜</p>
      <p><%= @room.description %></p>

      <%= link_to "予約する", new_room_reservation_path(@room), class: "btn btn-primary w-100 mt-3" %>

      <% if user_signed_in? && current_user == @room.user %>
        <div class="mt-2 d-flex gap-2">
          <%= link_to "編集", edit_room_path(@room), class: "btn btn-outline-secondary w-50" %>
          <%= link_to "削除", room_path(@room), data: { turbo_method: :delete, turbo_confirm: "施設を削除しますか？" }, class: "btn btn-outline-danger w-50" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
