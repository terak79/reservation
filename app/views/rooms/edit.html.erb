<h1>施設を編集する</h1>

<%= form_with model: @room do |f| %>
  <div>
    <%= f.label :name, "施設名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description, "施設詳細" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :price, "料金（/日）" %>
    <%= f.number_field :price %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :image, "施設画像" %>
    <%= f.file_field :image %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<%= link_to "戻る", :back %>
