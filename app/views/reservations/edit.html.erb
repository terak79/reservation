<div class="container mt-4">
  <%= link_to "← 戻る", :back, class: "text-decoration-none mb-3 d-inline-block" %>

  <div class="row justify-content-center mt-3">
    <div class="col-md-6">
      <div class="card p-4">
        <h2 class="mb-4"><%= @room.name %>の予約を編集する</h2>

        <%= form_with model: @reservation, url: reservation_path(@reservation) do |f| %>
          <div class="mb-3">
            <%= f.label :check_in, "チェックイン日", class: "form-label" %>
            <%= f.date_field :check_in, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :check_out, "チェックアウト日", class: "form-label" %>
            <%= f.date_field :check_out, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :number_of_people, "人数", class: "form-label" %>
            <%= f.number_field :number_of_people, min: 1, class: "form-control" %>
          </div>

          <%= f.submit "更新する", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
