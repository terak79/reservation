<div class="container mt-4">
  <%= link_to "← 戻る", :back, class: "text-decoration-none mb-3 d-inline-block" %>

  <div class="row justify-content-center mt-3">
    <div class="col-md-6">
      <div class="card p-4">
        <h2 class="mb-4"><%= @room.name %>を予約する</h2>

        <%= form_with model: [@room, @reservation] do |f| %>
          <div class="mb-3">
            <%= f.label :check_in, "チェックイン日", class: "form-label" %>
            <%= f.date_field :check_in, class: "form-control #{'is-invalid' if @reservation.errors[:check_in].any?}" %>
            <div class="invalid-feedback"><%= @reservation.errors[:check_in].first %></div>
          </div>

          <div class="mb-3">
            <%= f.label :check_out, "チェックアウト日", class: "form-label" %>
            <%= f.date_field :check_out, class: "form-control #{'is-invalid' if @reservation.errors[:check_out].any?}" %>
            <div class="invalid-feedback"><%= @reservation.errors[:check_out].first %></div>
          </div>

          <div class="mb-3">
            <%= f.label :number_of_people, "人数", class: "form-label" %>
            <%= f.number_field :number_of_people, min: 1, class: "form-control #{'is-invalid' if @reservation.errors[:number_of_people].any?}" %>
            <div class="invalid-feedback"><%= @reservation.errors[:number_of_people].first %></div>
          </div>

          <%= f.submit "予約する", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
