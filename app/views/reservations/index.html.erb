<div class="container mt-4">
  <h2 class="mb-4">予約一覧</h2>

  <% if @reservations.empty? %>
    <p class="text-muted">予約はありません。</p>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% @reservations.each do |reservation| %>
        <div class="col">
          <div class="card h-100">
            <% if reservation.room.image.present? %>
              <%= image_tag reservation.room.image.url, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            <% end %>
            <div class="card-body">
              <h5 class="card-title"><%= reservation.room.name %></h5>
              <p class="text-muted"><%= reservation.room.address %></p>
              <p><%= reservation.room.description %></p>s
              <p>チェックイン: <%= reservation.check_in.strftime("%Y/%m/%d") %></p>
              <p>チェックアウト: <%= reservation.check_out.strftime("%Y/%m/%d") %></p>
              <% nights = (reservation.check_out - reservation.check_in).to_i %>
              <p>宿泊日数: <%= nights %>泊 / <%= reservation.number_of_people %>人</p>
              <p class="text-danger fw-bold">合計: ¥<%= number_with_delimiter(reservation.room.price * nights * reservation.number_of_people) %></p>
              <p class="text-muted">予約確定: <%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
            </div>
            <div class="card-footer d-flex gap-2">
              <%= link_to "編集", edit_reservation_path(reservation), class: "btn btn-outline-secondary w-50" %>
              <%= link_to "削除", reservation_path(reservation), data: { turbo_method: :delete, turbo_confirm: "予約を削除しますか？" }, class: "btn btn-outline-danger w-50" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
